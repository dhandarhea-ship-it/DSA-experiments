
#include <iostream>
using namespace std;

#define SIZE 10

class HashTable {
    int table[SIZE];

public:
    HashTable() {
        for (int i = 0; i < SIZE; i++)
            table[i] = -1;
    }

    void insert(int key) {
        int index = key % SIZE;
        int start = index;

        while (table[index] != -1) {
            index = (index + 1) % SIZE;

            if (index == start) {
                cout << "Hash Table is full\n";
                return;
            }
        }

        table[index] = key;
        cout << key << " inserted at index " << index << endl;
    }

    void display() {
        cout << "\nHash Table:\n";

        for (int i = 0; i < SIZE; i++) {
            cout << i << " : ";

            if (table[i] == -1)
                cout << "Empty";
            else
                cout << table[i];

            cout << endl;
        }
    }
};

int main() {
    HashTable h;

    h.insert(25);
    h.insert(35);
    h.insert(45);
    h.insert(15);
    h.insert(20);

    h.display();

    return 0;
}
